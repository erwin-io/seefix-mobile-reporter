{
  "name": "seefix-mobile-reporter",
  "version": "0.1.0",
  "author": "SEEFIX",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "ionic_serve": "ionic serve --host 127.0.0.1",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "cap:sync": "ng build && npx cap sync android",
    "cap:sync:local": "ng build --configuration development && node scripts/cap-sync-local.mjs",
    "cap:open": "npx cap open android"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "^9.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "@angular/language-service": "21.2.25",
    "@capacitor/cli": "8.5.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "21.4.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "~4.0.18"
  },
  "description": "SEEFIX Reporter mobile app (Ionic Angular standalone + Capacitor)",
  "engines": {
    "node": ">=22.12.0"
  }
}
